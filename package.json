{
  "name": "morocco-pc",
  "version": "0.1.0",
  "description": "Moroccan gaming PC recommendation platform",
  "private": true,
  "scripts": {
    "test:db": "node scripts/test-db.js",
    "test:unit": "node --test \"src/**/*.test.js\"",
    "test:scripts": "node --test \"scripts/lib/*.test.js\"",
    "seed": "node scripts/run-seeds.js",
    "gen:decisions": "node scripts/gen-decision-index.js",
    "gen:schema": "node scripts/gen-schema-reference.js",
    "verify:docs": "node scripts/verify-docs.js",
    "verify:replay": "node scripts/verify-migrations-replay.js --test-db",
    "verify:pi1": "node scripts/verify-pool-independence.js",
    "start:api": "node apps/api/src/server.js",
    "test:api": "node --test \"apps/api/test/unit/*.test.js\"",
    "test:api:db": "node apps/api/test/run-db-tests.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
