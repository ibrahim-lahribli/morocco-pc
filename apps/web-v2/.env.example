# ---------------------------------------------------------------------------
# Morocco-PC V2 - environment variables
#
# Copy this file to `.env.local` and adjust the values for your machine.
# Every variable is OPTIONAL: leave one blank (or delete the line) to use its
# built-in default. An empty value is treated exactly like an unset one.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Absolute public origin of this app. Used for canonical URLs, hreflang and
# Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3220

# Browser-facing base URL of the Morocco-PC API (v1), no trailing slash.
# Inlined into the client bundle at BUILD time: changing it requires a rebuild.
# Empty or unset falls back to the local default, http://localhost:3000 (the
# API's own PORT default).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-only base URL for server components and route handlers. Read at
# request time, never exposed to the browser. Empty or unset falls back to
# NEXT_PUBLIC_API_BASE_URL, then http://localhost:3000.
API_BASE_URL=http://localhost:3000

# The API only accepts browser calls whose Origin is listed in its own
# ALLOWED_ORIGINS. For a local run against this app:
#   ALLOWED_ORIGINS=http://localhost:3220 npm run start:api
#
# The preview page makes no API request, so these values are inert today: the
# live integration stays unverified until the separate smoke-test task.
