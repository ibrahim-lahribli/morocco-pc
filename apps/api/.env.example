# morocco-pc API - every environment variable it reads. Values are empties or
# safe defaults; copy this file and fill it in, and NEVER commit a filled .env.

# --- HTTP listener -----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Comma-separated allow-list for CORS. Empty means CORS is DISABLED entirely
# (no Access-Control-Allow-Origin header at all), which is the safe default.
ALLOWED_ORIGINS=

# --- logging -----------------------------------------------------------------
LOG_LEVEL=info
# 1 enables pino-pretty, which is a devDependency; production installs log JSON
# regardless, because the require is feature-detected.
LOG_PRETTY=0

# --- response identity -------------------------------------------------------
# Reported as `engine_version` (POST) and `served_by.engine_version` (both).
# The deploy pipeline sets this to the git short SHA; 'dev' is the fallback.
ENGINE_VERSION=dev

# --- database target ---------------------------------------------------------
# The API WRITES Layer 4 rows, so it starts against the isolated TEST branch and
# refuses to start otherwise. BOTH urls are required: the guard compares their
# hostnames to prove they are different endpoints, and its error messages never
# echo a URL or a host.
DATABASE_URL=
TEST_DATABASE_URL=
# Set to 1 ONLY to deliberately run against the shared dev database. There is no
# other way to reach it, and nothing in CI sets it.
API_ALLOW_SHARED=0
