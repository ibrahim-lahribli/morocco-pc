# morocco-pc API - every environment variable it reads. Values are empties or
# safe defaults; copy this file and fill it in, and NEVER commit a filled .env.

# --- HTTP listener -----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Comma-separated allow-list for CORS. Empty means CORS is DISABLED entirely
# (no Access-Control-Allow-Origin header at all), which is the safe default.
# Example: https://moroccopc.ma,https://www.moroccopc.ma
# An allowed origin is echoed exactly (never a wildcard); empty is DISABLED, not open.
ALLOWED_ORIGINS=

# Trusted proxy, so the rate limiter can key on the real client IP instead of the
# proxy's. EMPTY (the default) IGNORES X-Forwarded-For entirely - correct for a
# directly reachable process, and the only safe default.
# Set it to the proxy's address or CIDR (or a proxy-addr named range: loopback,
# linklocal, uniquelocal), comma-separated - e.g. 127.0.0.1 for a same-host
# reverse proxy. NOT a hop count: fastify@5.12 disables hop-count trust because
# it cannot validate the immediate peer, and 'true' would let any caller pick its
# own rate-limit bucket - both are refused at startup, and so is a /0 prefix.
TRUST_PROXY=

# --- logging -----------------------------------------------------------------
LOG_LEVEL=info
# 1 enables pino-pretty, which is a devDependency; production installs log JSON
# regardless, because the require is feature-detected.
LOG_PRETTY=0

# --- response identity -------------------------------------------------------
# Reported as `engine_version` (POST) and `served_by.engine_version` (both).
# The deploy pipeline sets this to the git short SHA; 'dev' is the fallback.
ENGINE_VERSION=dev

# --- database target ---------------------------------------------------------
# The API WRITES Layer 4 rows, so it starts against the isolated TEST branch and
# refuses to start otherwise. In that LOCAL shape BOTH urls are required: the
# pool is TEST_DATABASE_URL and DATABASE_URL is the hostname baseline the guard
# compares against it; the guard never echoes a URL or a host.
DATABASE_URL=
TEST_DATABASE_URL=
# 1 makes DATABASE_URL the pool and TEST_DATABASE_URL unused (it must then be
# unset). That is the DEPLOYED shape, and BOTH deployed environments use it:
# production points DATABASE_URL at the EU project, staging at the TEST branch.
# It is a guard bypass, not a claim that the target is the shared dev database;
# nothing in CI sets it.
API_ALLOW_SHARED=0
