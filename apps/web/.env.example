# The API this build talks to. Contract 1.5.0; types come from its committed
# OpenAPI snapshot, so a server on a different contract fails `check:api-types`
# only if the SNAPSHOT moves - a stale deploy is not detected at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# The API root the NEXT SERVER uses for its SSR fetches (S11). It is read at
# request time and is deliberately not NEXT_PUBLIC_, so a deployment can point
# the server at an internal address while the browser keeps the public origin
# above. Leave it unset and the server falls back to that public URL - which is
# why a local run needs nothing here.
# API_BASE_URL=http://localhost:3000

# The site's PUBLIC ORIGIN, used by sitemap.xml, robots.txt and every page's
# canonical + hreflang (S18). Scheme + host only: a path here fails the build on
# purpose, because it would prefix every canonical. Unset is the local default
# (http://localhost:3210, the dev/start port). Set it FOR THE BUILD: prerendered
# pages bake their canonical, while sitemap.xml and robots.txt read it per
# request, so a runtime-only value makes the two disagree.
# NEXT_PUBLIC_SITE_URL=https://morocco-pc.example

# Port for the fixture mock API (`npm run mock:api`). Playwright starts it on
# this port and points the Next process at it through API_BASE_URL, so the
# results page's SERVER fetch is exercised by the suite rather than mocked in a
# browser.
MOCK_API_PORT=3211
