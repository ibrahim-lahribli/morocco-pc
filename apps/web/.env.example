# The API this build talks to. Contract 1.5.0; types come from its committed
# OpenAPI snapshot, so a server on a different contract fails `check:api-types`
# only if the SNAPSHOT moves - a stale deploy is not detected at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# The API root the NEXT SERVER uses for its SSR fetches (S11). It is read at
# request time and is deliberately not NEXT_PUBLIC_, so a deployment can point
# the server at an internal address while the browser keeps the public origin
# above. Leave it unset and the server falls back to that public URL - which is
# why a local run needs nothing here.
# API_BASE_URL=http://localhost:3000

# A RELATIVE public base makes THIS server the API's front door: the browser
# calls `<base>/v1/...` on the app's own origin and next.config.ts forwards each
# request to API_BASE_URL server-to-server. Use it to run a local dev server
# against a DEPLOYED API whose CORS policy does not list http://localhost:3210 -
# there is no cross-origin request to refuse. Set API_BASE_URL beside it; an
# absolute base (above) registers no rewrite. Put the pair in
# `.env.development.local`, which only `next dev` loads, so `npm run build` and
# `npm test` keep their fixture path.
# NEXT_PUBLIC_API_BASE_URL=/api

# The site's PUBLIC ORIGIN, used by sitemap.xml, robots.txt and every page's
# canonical + hreflang (S18). Scheme + host only: a path here fails the build on
# purpose, because it would prefix every canonical. Unset is the local default
# (http://localhost:3210, the dev/start port). Set it FOR THE BUILD: prerendered
# pages bake their canonical, while sitemap.xml and robots.txt read it per
# request, so a runtime-only value makes the two disagree.
# NEXT_PUBLIC_SITE_URL=https://morocco-pc.example

# Analytics (S22). UNSET is OFF, and off means no third-party request at all.
# The browser asks GET /api/analytics/config after the load event, so these are
# read PER REQUEST by the server: turning measurement on, off or elsewhere needs
# a restart, not a rebuild. "plausible" needs ANALYTICS_DOMAIN (the data-domain),
# "umami" needs ANALYTICS_WEBSITE_ID (the data-website-id). Both providers are
# cookie-free, and the loader always sets data-exclude-search, so a budget in
# the address bar never reaches the provider. A malformed value fails loudly
# (a logged 500 from that endpoint), never silently.
# ANALYTICS_PROVIDER=plausible
# ANALYTICS_DOMAIN=morocco-pc.example
# ANALYTICS_WEBSITE_ID=
# Self-hosted Plausible or Umami only; absolute http(s).
# ANALYTICS_SCRIPT_URL=https://plausible.example/js/script.js

# Port for the fixture mock API (`npm run mock:api`). Playwright starts it on
# this port and points the Next process at it through API_BASE_URL, so the
# results page's SERVER fetch is exercised by the suite rather than mocked in a
# browser.
MOCK_API_PORT=3211
