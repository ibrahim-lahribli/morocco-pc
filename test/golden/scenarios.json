{
  "version": 1,
  "note": "E0 golden scenarios (docs/briefs/engine.md). Data only: the assertion LOGIC lives in scripts/lib/scenario-eval.js; scenarios, thresholds and application rules live here so they can change without touching code. Every threshold is a HYPOTHESIS pending the PC-literate human review (H3) and carries a status field; changing one requires a test/golden/CHANGELOG.md entry naming the reviewer.",
  "thresholds": {
    "A1_min_budget": {
      "value": 10000,
      "status": "hypothesis",
      "reason": "A1 (pair diversity) is asserted only at budgets at or above this."
    },
    "A1_min_distinct_pairs": {
      "value": 3,
      "status": "hypothesis",
      "reason": "Distinct (CPU,GPU) pairs required in the selected/persisted set."
    },
    "A2_spend_ratio_min": {
      "value": 0.8,
      "status": "hypothesis",
      "reason": "Performance-leaning top build must spend at least this share of budget."
    },
    "A3_signature_overlap_max": {
      "value": 0.5,
      "status": "hypothesis",
      "reason": "GAMING vs WORKSTATION build-signature overlap must be strictly below this."
    },
    "A3_gaming_gpu_share": {
      "min": 0.3,
      "max": 0.5,
      "status": "hypothesis",
      "reason": "GAMING top-build GPU share of total price band."
    },
    "A4_vram_floor_gb": {
      "value": {
        "1080p": 8,
        "1440p": 12,
        "2160p": 16
      },
      "status": "hypothesis",
      "reason": "Minimum selected-GPU VRAM per target resolution."
    },
    "A5_priority_strict": {
      "value": true,
      "status": "hypothesis",
      "reason": "Priority 1 (price-first) rank-1 price must be strictly below priority 5."
    },
    "A6_office_price_ratio_max": {
      "value": 0.4,
      "status": "hypothesis",
      "reason": "OFFICE top build must cost at most this multiple of the S03 GAMING top build."
    },
    "A7_within_budget": {
      "value": null,
      "status": "corrected",
      "reason": "Corrected to the code's Decision 27 semantics on 2026-10-08: S01 @5000 sits ABOVE the 4477 floor so within_budget is TRUE (the zero builds are a compatibility limit, not a budget shortfall); S01b @4000 sits below the floor so within_budget is FALSE. The brief's literal 'within_budget false' at 5000 contradicted the engine."
    },
    "A8_score_tolerance": {
      "value": 0.001,
      "status": "hypothesis",
      "reason": "Two consecutive passes differ by clock drift only; signatures are compared exactly, scores within this tolerance."
    }
  },
